flowchart TD
    %% User Input Layer
    A1[Text Input] --> B[Input Pre-processing & Unification]
    A2[Voice Input] --> B
    A3[Video Input] --> B
    
    %% Pre-processing Layer
    B --> C1[Speech-to-Text Engine]
    B --> C2[Video Analysis Engine]
    B --> D[Central Analysis Engine]
    
    %% Speech and Video Processing
    C1 --> C1a[Raw Text Output]
    C2 --> C2a[Transcription]
    C2 --> C2b[Emotional Cues]
    
    %% Convergence to Analysis
    A1 --> D
    C1a --> D
    C2a --> D
    C2b --> D
    
    %% Analysis Engine
    D --> E[Input Analysis<br/>Mood & Intent Detection]
    
    %% Contextual Enrichment
    E --> F[Memory System<br/>RAG, Vector DB]
    F --> F1[Past Conversations]
    F --> F2[User Preferences]
    F --> F3[Wellness Goals]
    
    %% Core Logic
    E --> G[Core AI Logic<br/>LLM]
    F1 --> G
    F2 --> G
    F3 --> G
    
    %% Decision Outputs
    G --> H1[Proactive Tasks Instructions]
    G --> H2[Immediate Response Text]
    
    %% Action Handlers
    H1 --> I1[Agentic System]
    H2 --> I2[Response Handler]
    
    %% Agentic System Tasks
    I1 --> I1a[Schedule Reminders]
    I1 --> I1b[Wellness Nudges]
    I1 --> I1c[Future Check-ins]
    
    %% Response Formatting
    I2 --> I2a[Format for UI]
    I2 --> I2b[Add Interactive Elements]
    
    %% Delivery Layer
    I1a --> J[Notification Service]
    I1b --> J
    I1c --> J
    I2a --> J
    I2b --> J
    
    %% Queue Management
    J --> J1[Immediate Reply Queue]
    J --> J2[Scheduled Tasks Queue]
    
    %% Final Output
    J1 --> K1[Instant Personalized Reply]
    J2 --> K2[Scheduled Follow-ups]
    
    %% User Experience
    K1 --> L[User Receives Support]
    K2 --> L
    
    %% Styling with enhanced readability
    classDef inputLayer fill:#e3f2fd,stroke:#1976d2,stroke-width:3px,color:#000
    classDef processingLayer fill:#f3e5f5,stroke:#7b1fa2,stroke-width:3px,color:#000
    classDef analysisLayer fill:#e8f5e8,stroke:#388e3c,stroke-width:3px,color:#000
    classDef logicLayer fill:#fff3e0,stroke:#f57c00,stroke-width:3px,color:#000
    classDef outputLayer fill:#fce4ec,stroke:#c2185b,stroke-width:3px,color:#000
    classDef default stroke-width:2px,color:#000
    
    class A1,A2,A3 inputLayer
    class B,C1,C2,C1a,C2a,C2b processingLayer
    class D,E,F,F1,F2,F3 analysisLayer
    class G,H1,H2,I1,I2,I1a,I1b,I1c,I2a,I2b logicLayer
    class J,J1,J2,K1,K2,L outputLayer